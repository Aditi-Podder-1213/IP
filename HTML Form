<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Regitration Form</title>
</head>

<body>

    <form action="index.html" target="_self" autocomplete="on" method="post">

        <label>Name:</label>

        <input type="text" placeholder="Enter your full name" name="fullname" />

        <br><br>

        <label>Email Address:</label>

        <input type="email" placeholder="Enter your email" name="email" required />

        <br><br>

        <label>Mobile Number:</label>

        <input type="text" placeholder="Enter your mobile number" name="phone" required />

        <br><br>

        <label>Password:</label>

        <input type="password" placeholder="Create a password" name="password" required />

        <br><br>

        <label>Gender:</label>

        <input type="radio" name="gender" value="male" />Male

        <input type="radio" name="gender" value="female" />Female

        <br><br>

        <label>Terms:</label>

        <input type="checkbox" name="terms" />
        I accept the terms

        <br><br>

        <label>Select City:</label>

        <select name="city">
            <option value="dhaka">Dhaka</option>
            <option value="chattogram">Chattogram</option>
            <option value="sylhet">Sylhet</option>
        </select>

        <br><br>

        <textarea name="message" placeholder="Write your message"></textarea>

        <br><br>

        <button type="submit">Submit</button>
    </form>



</body>

</html>
